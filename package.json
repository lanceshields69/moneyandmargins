{
  "name": "money-and-margins",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && tsx scripts/build-articles.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:geometry": "tsx scripts/build-us-states.ts",
    "fetch:races": "tsx scripts/fetch-races.ts",
    "check:incomplete": "tsx scripts/check-incomplete.ts",
    "prebuild": "npm run check:incomplete && tsx scripts/validate-results.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^4.3.4",
    "d3-geo": "^3.1.1",
    "dotenv": "^16.4.7",
    "jsdom": "^25.0.1",
    "topojson-client": "^3.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "us-atlas": "^3.0.1",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
